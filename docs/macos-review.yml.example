name: Private Apple Silicon candidate review
on:
  push:
    branches: [feature/macos-private]
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: maple-macos-review-${{ github.ref }}
  cancel-in-progress: false
jobs:
  review:
    runs-on: macos-14
    timeout-minutes: 60
    env:
      MACOSX_DEPLOYMENT_TARGET: '14.0'
      OMP_NUM_THREADS: '1'
      OPENBLAS_NUM_THREADS: '1'
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: '3.13.17'
          architecture: arm64
      - name: Hash-pinned Mac dependencies
        run: |
          python -m pip install --require-hashes --only-binary=:all: -r requirements-build-mac.txt
      - name: Python and pinned native source advisory checks
        run: |
          python tools/check_advisories.py requirements-build-mac.txt verification/macos-review
          python tools/check_native_advisories.py verification/macos-review
      - name: Full native Mac regression suites (synthetic, no desktop capture)
        run: python tools/run_mac_tests.py
      - name: Compile minimal pinned static OCR
        run: python tools/build_ocr_macos.py
      - name: Assemble ad-hoc signed Mac app
        run: python tools/build_macos.py
      - name: Verify exact package, OCR and GUI startup
        run: python tools/verify_macos.py
      - name: Preserve test evidence and candidate
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        with:
          name: maple-macos-candidate
          retention-days: 14
          if-no-files-found: error
          path: |
            verification/macos-review/*.json
            verification/macos-review/*.txt
            verification/macos-review/candidate-debug.zip
            verification/macos-review/release/*
