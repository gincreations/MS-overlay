name: Isolated Windows candidate review
on:
  workflow_dispatch:
    inputs:
      extended_security:
        description: 'Trace an exact published candidate and test search paths (no rebuild)'
        type: boolean
        default: false
      reuse_ocr_run_id:
        description: 'Reuse hash/provenance-verified native OCR from this repository run'
        type: string
        default: ''
      review_run_id:
        description: 'Optional successful build run to trace before publication'
        type: string
        default: ''
      review_tag:
        description: 'Published or draft candidate tag for bounded trace'
        type: string
        default: 'v0.1.19-rc1'
      zip_sha256:
        description: 'Expected exact portable ZIP SHA256'
        type: string
        default: ''
      exe_sha256:
        description: 'Expected exact application EXE SHA256'
        type: string
        default: '1a9eada8519e582ce14fdf1f9530934392e243a02eccc97db56def746e6356f3'
permissions:
  contents: read
  actions: read
concurrency:
  group: maple-windows-review-${{ github.ref }}
  cancel-in-progress: false
jobs:
  review:
    if: ${{ !inputs.extended_security }}
    runs-on: windows-latest
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: '3.13.17'
      - name: Install hash-pinned test dependencies
        run: python -m pip install --require-hashes -r requirements-build.txt
      - name: Check patched dependency advisories
        run: python tools/check_advisories.py
      - name: Check pinned native OCR source advisories
        run: python tools/check_native_advisories.py
      - name: Diagnose Windows recognition kernel timings
        timeout-minutes: 2
        run: python tools/benchmark_recognition.py
      - name: Regression - test_potion_readout
        run: python tools/run_windows_tests.py test_potion_readout
      - name: Regression - test_colors
        run: python tools/run_windows_tests.py test_colors
      - name: Regression - test_dialog_layout
        run: python tools/run_windows_tests.py test_dialog_layout
      - name: Regression - test_auto_potion_ui
        run: python tools/run_windows_tests.py test_auto_potion_ui
      - name: Regression - test_hotbar
        run: python tools/run_windows_tests.py test_hotbar
      - name: Regression - test_auto_potions
        run: python tools/run_windows_tests.py test_auto_potions
      - name: Regression - test_estimate_ui
        run: python tools/run_windows_tests.py test_estimate_ui
      - name: Regression - test_estimates
        run: python tools/run_windows_tests.py test_estimates
      - name: Regression - test_exp_rollback
        run: python tools/run_windows_tests.py test_exp_rollback
      - name: Regression - test_inventory_move
        run: python tools/run_windows_tests.py test_inventory_move
      - name: Regression - test_logic
        run: python tools/run_windows_tests.py test_logic
      - name: Regression - test_ocr
        run: python tools/run_windows_tests.py test_ocr
      - name: Regression - test_potion_anchor
        run: python tools/run_windows_tests.py test_potion_anchor
      - name: Regression - test_potion_speed
        run: python tools/run_windows_tests.py test_potion_speed
      - name: Regression - test_potion_ui
        run: python tools/run_windows_tests.py test_potion_ui
      - name: Regression - test_potions
        run: python tools/run_windows_tests.py test_potions
      - name: Regression - test_privacy
        run: python tools/run_windows_tests.py test_privacy
      - name: Regression - test_rate_audit
        run: python tools/run_windows_tests.py test_rate_audit
      - name: Regression - test_report
        run: python tools/run_windows_tests.py test_report
      - name: Regression - test_screen
        run: python tools/run_windows_tests.py test_screen
      - name: Regression - test_security_runtime
        run: python tools/run_windows_tests.py test_security_runtime
      - name: Regression - test_theme
        run: python tools/run_windows_tests.py test_theme
      - name: Regression - test_ui
        run: python tools/run_windows_tests.py test_ui
      - name: Regression - test_upstream_features
        run: python tools/run_windows_tests.py test_upstream_features
      - name: Regression - test_upstream_ui
        run: python tools/run_windows_tests.py test_upstream_ui
      - name: Fetch and verify preserved native OCR (no execution)
        if: ${{ inputs.reuse_ocr_run_id != '' }}
        env:
          GH_TOKEN: ${{ github.token }}
          REUSE_OCR_RUN_ID: ${{ inputs.reuse_ocr_run_id }}
        run: python tools/reuse_ocr_runtime.py
      - name: Build minimal pinned native OCR (no execution)
        if: ${{ inputs.reuse_ocr_run_id == '' }}
        run: python tools/build_ocr_runtime.py
      - name: Preserve native OCR provenance and build for failure diagnosis
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        with:
          name: native-ocr-build-not-release-cleared
          retention-days: 3
          path: |
            verification/windows-review/ocr-runtime/**
            verification/windows-review/ocr-provenance.json
      - name: Prepare complete candidate without running it
        run: python tools/prepare_windows_review.py
      - name: Defender scan; fail closed if unavailable or detected
        shell: pwsh
        run: ./tools/review_defender.ps1
      - name: Verify scanned minimal OCR version and image recognition
        run: python tools/verify_ocr_runtime.py
      - name: Packaged startup/setup check on isolated runner
        shell: pwsh
        run: |
          $exe = (Resolve-Path 'verification/windows-review/candidate/Maple Private Overlay.exe').Path
          $p = Start-Process -FilePath $exe -ArgumentList '--check-setup' -Wait -PassThru -WorkingDirectory (Split-Path $exe)
          if ($p.ExitCode -ne 0) { throw "Packaged setup failed: $($p.ExitCode)" }
          $r = Get-Content 'verification/windows-review/defender.json' | ConvertFrom-Json
          $r.runtimeTestCompleted = $true
          $r | ConvertTo-Json | Set-Content 'verification/windows-review/defender.json'
      - name: Package exact scanned runtime and compare embedded source
        run: python tools/package_windows_review.py
      - name: Scan final portable ZIP without modifying it
        shell: pwsh
        run: |
          $zip = (Resolve-Path 'verification/windows-review/download/Maple-Private-Overlay-0.1.19-rc1-portable.zip').Path
          $before = (Get-FileHash -Algorithm SHA256 -LiteralPath $zip).Hash
          $scanner = Join-Path $env:ProgramFiles 'Windows Defender/MpCmdRun.exe'
          & $scanner -Scan -ScanType 3 -File $zip -DisableRemediation
          if ($LASTEXITCODE -ne 0) { throw 'Final ZIP scan failed; no download artifact allowed.' }
          if ((Get-FileHash -Algorithm SHA256 -LiteralPath $zip).Hash -ne $before) { throw 'ZIP changed during scan.' }
          $r = Get-Content 'verification/windows-review/download/REVIEW.json' | ConvertFrom-Json
          $r.portableZipScanned = $true
          $r | ConvertTo-Json | Set-Content 'verification/windows-review/download/REVIEW.json'
      - name: Preserve verified download candidate
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        with:
          name: windows-verified-download
          retention-days: 7
          compression-level: 0
          path: verification/windows-review/download/*
      - name: Preserve review reports
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        with:
          name: windows-review-reports
          retention-days: 3
          path: |
            verification/windows-review/*.json
            verification/windows-review/*.txt
            verification/windows-review/candidate/setup-check*.json
            verification/windows-review/candidate/setup-check*.txt

  extended-security:
    if: ${{ inputs.extended_security }}
    runs-on: windows-latest
    timeout-minutes: 15
    env:
      REVIEW_RUN_ID: ${{ inputs.review_run_id }}
      REVIEW_TAG: ${{ inputs.review_tag }}
      REVIEW_ZIP_SHA256: ${{ inputs.zip_sha256 }}
      REVIEW_EXE_SHA256: ${{ inputs.exe_sha256 }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: '3.13.17'
      - name: Fetch exact published artifact (token only in this step)
        shell: pwsh
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          New-Item -ItemType Directory -Force verification/extended-security | Out-Null
          if ($env:REVIEW_TAG -notmatch '^v[0-9]+\.[0-9]+\.[0-9]+(-rc[0-9]+)?$') { throw 'Invalid candidate tag' }
          $asset = 'Maple-Private-Overlay-' + $env:REVIEW_TAG.Substring(1) + '-portable.zip'
          if ($env:REVIEW_RUN_ID) {
            if ($env:REVIEW_RUN_ID -notmatch '^[0-9]+$') { throw 'Invalid build run' }
            gh run download $env:REVIEW_RUN_ID --repo $env:GITHUB_REPOSITORY --name windows-verified-download --dir verification/extended-security
          } else {
            gh release download $env:REVIEW_TAG --repo $env:GITHUB_REPOSITORY --pattern $asset --dir verification/extended-security
          }
          if ($LASTEXITCODE -ne 0) { throw 'Candidate download failed' }
      - name: Scan and trace bounded runtime plus search-path probes
        shell: pwsh
        run: ./tools/extended_security.ps1
      - name: Summarize captured process behavior
        if: always()
        run: python tools/summarize_security_trace.py
      - name: Preserve sanitized review reports
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        with:
          name: extended-security-reports
          retention-days: 7
          path: |
            verification/extended-security/*.json
            verification/extended-security/*summary.txt
